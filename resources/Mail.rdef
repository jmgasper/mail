resource app_signature "application/x-vnd.air-Mail";
resource app_flags B_SINGLE_LAUNCH;
// Messages and mailto links Mail can open. Use Mail → Make Mail the default
// email application (or FileTypes) to prefer it over Haiku's Mail.
resource file_types message {
    "types" = "text/x-email",
    "types" = "message/rfc822",
    "types" = "application/x-vnd.Be.URL.mailto"
};
resource app_version {
    major = 0,
    middle = 1,
    minor = 0,
    variety = B_APPV_DEVELOPMENT,
    internal = 0,
    short_info = "Mail",
    long_info = "Mail for air/OS and Haiku"
};
resource(101, "BEOS:ICON") #'VICN' import "Mail.hvif";
