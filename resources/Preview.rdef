resource app_signature "application/x-vnd.air-Mail-Preview";
resource app_flags B_SINGLE_LAUNCH;
resource app_version {
    major = 0,
    middle = 1,
    minor = 0,
    variety = B_APPV_DEVELOPMENT,
    internal = 0,
    short_info = "Mail preview",
    long_info = "Message preview for Mail"
};
resource(101, "BEOS:ICON") #'VICN' import "Mail.hvif";
